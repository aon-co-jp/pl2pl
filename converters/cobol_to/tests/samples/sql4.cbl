000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. SQL3.
000300 DATA DIVISION.
000400 WORKING-STORAGE SECTION.
000500 01 WS-ID PIC 9(3) VALUE 0.
000600 01 WS-NAME PIC X(10) VALUE SPACES.
000700 01 WS-NAMEI PIC S9(4) VALUE 0.
000800 PROCEDURE DIVISION.
000900     EXEC SQL CREATE TABLE T (ID INTEGER, NAME TEXT) END-EXEC.
001000     MOVE 1 TO WS-ID. MOVE "ALICE" TO WS-NAME.
001100     EXEC SQL INSERT INTO T VALUES (:WS-ID,
               :WS-NAME INDICATOR :WS-NAMEI)
001200         END-EXEC.
001300     MOVE 2 TO WS-ID. MOVE -1 TO WS-NAMEI.
001400     EXEC SQL INSERT INTO T VALUES (:WS-ID,
               :WS-NAME INDICATOR :WS-NAMEI)
001500         END-EXEC.
001600     MOVE 1 TO WS-ID.
001700     EXEC SQL SELECT NAME INTO :WS-NAME INDICATOR :WS-NAMEI FROM T
001800         WHERE ID = :WS-ID END-EXEC.
001900     DISPLAY "ID1 " WS-NAME " IND=" WS-NAMEI.
002000     MOVE 2 TO WS-ID.
002100     EXEC SQL SELECT NAME INTO :WS-NAME INDICATOR :WS-NAMEI FROM T
002200         WHERE ID = :WS-ID END-EXEC.
002300     DISPLAY "ID2 [" WS-NAME "] IND=" WS-NAMEI.
002400     STOP RUN.
